---
import { useT, otherLocale, rel, SITE, LOCALE_NAME, type Locale } from '../i18n/ui';

export interface Props {
  locale: Locale;
  path?: string;
  altPath?: string | null;
}
const { locale, path = '', altPath } = Astro.props;
const t = useT(locale);
const other = otherLocale(locale);
const clean = (p: string) => p.replace(/^\/+|\/+$/g, '');
const current = clean(path);

const nav = [
  { key: 'nav.home', to: '' },
  { key: 'nav.about', to: 'about' },
  { key: 'nav.research', to: 'research' },
  { key: 'nav.articles', to: 'articles' },
  { key: 'nav.projects', to: 'projects' },
  { key: 'nav.contact', to: 'contact' },
] as const;

const isActive = (to: string) => (to === '' ? current === '' : current === to || current.startsWith(to + '/'));

// The switcher points at the translated page when one exists, otherwise the
// other language's home page — it must never land on a 404 (brief §4).
const switchHref = altPath === null ? rel(other) : rel(other, clean(altPath ?? path));
const switchTitle = altPath === null ? t('articles.noTranslation') : LOCALE_NAME[other];
---

<header class="site-header">
  <div class="hd">
    <a class="brand" href={rel(locale)}>
      <span class="brand__mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="19" height="19" fill="none">
          <path d="M4 19V9.5" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" />
          <path d="M12 19V4.5" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" />
          <path d="M20 19V13" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" />
          <path d="M3.5 12.5L11 6.2a1 1 0 0 1 1.2-.05L14 7.5a1 1 0 0 0 1.2-.05l5.3-4.4" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
      <span class="brand__txt">
        <span class="brand__name">{locale === 'ar' ? SITE.nameAr : SITE.nameEn}</span>
        <span class="brand__sub">{SITE.tagEn}</span>
      </span>
    </a>

    <nav class="nav-d" aria-label={t('nav.primary')}>
      {
        nav.map((item) => (
          <a href={rel(locale, item.to)} class:list={['nav-d__l', { 'is-active': isActive(item.to) }]} aria-current={isActive(item.to) ? 'page' : undefined}>
            {t(item.key)}
          </a>
        ))
      }
    </nav>

    <div class="hd__end">
      <a class="lang" href={switchHref} hreflang={other} lang={other} title={switchTitle} data-no-translation={altPath === null ? 'true' : undefined}>
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7">
          <circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18"></path>
        </svg>
        <span>{t('nav.switchTo')}</span>
      </a>
      <a class="btn btn--gold hd__cta" href={rel(locale, 'contact')}>{t('nav.cta')}</a>
      <button class="burger" id="burger" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label={t('nav.openMenu')}>
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path class="burger__a" d="M3 6h18"></path><path class="burger__b" d="M3 12h18"></path><path class="burger__c" d="M3 18h18"></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="mnav" id="mobile-nav" hidden>
    <nav aria-label={t('nav.primary')}>
      {
        nav.map((item) => (
          <a href={rel(locale, item.to)} class:list={['mnav__l', { 'is-active': isActive(item.to) }]} aria-current={isActive(item.to) ? 'page' : undefined}>
            {t(item.key)}
          </a>
        ))
      }
    </nav>
    <div class="mnav__foot">
      <a class="btn btn--gold" href={rel(locale, 'contact')}>{t('nav.cta')}</a>
      <a class="lang lang--m" href={switchHref} hreflang={other} lang={other}>
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7">
          <circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18"></path>
        </svg>
        <span>{t('nav.switchTo')}</span>
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 100;
    background: var(--navy);
    border-block-end: 1px solid rgba(255, 255, 255, 0.09);
  }
  .hd {
    max-width: var(--wrap);
    margin-inline: auto;
    padding: 10px clamp(18px, 4vw, 32px);
    display: flex;
    align-items: center;
    gap: clamp(12px, 2vw, 26px);
  }

  /* brand */
  .brand {
    display: flex;
    align-items: center;
    gap: 11px;
    text-decoration: none;
    flex: none;
    min-width: 0;
  }
  .brand__mark {
    width: 38px;
    height: 38px;
    border-radius: 9px;
    background: var(--gold);
    color: var(--navy);
    display: grid;
    place-items: center;
    flex: none;
  }
  .brand__txt {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .brand__name {
    color: #fff;
    font-weight: 700;
    font-size: clamp(15px, 1.1vw, 17px);
    line-height: 1.3;
    white-space: nowrap;
  }
  .brand__sub {
    color: var(--gold);
    font-family: var(--font-en);
    font-size: 10px;
    letter-spacing: 0.1em;
    line-height: 1.3;
    white-space: nowrap;
  }

  /* desktop nav */
  .nav-d {
    display: flex;
    gap: 2px;
    margin-inline-start: auto;
  }
  .nav-d__l {
    color: #C9D3DC;
    text-decoration: none;
    font-size: 0.94rem;
    font-weight: 500;
    padding: 9px 13px;
    border-radius: var(--r-sm);
    white-space: nowrap;
    position: relative;
    transition: color 0.15s, background 0.15s;
  }
  .nav-d__l:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.07);
  }
  .nav-d__l.is-active {
    color: #fff;
  }
  .nav-d__l.is-active::after {
    content: '';
    position: absolute;
    inset-inline: 13px;
    inset-block-end: 2px;
    height: 2px;
    background: var(--gold);
    border-radius: 2px;
  }

  .hd__end {
    display: flex;
    align-items: center;
    gap: 9px;
    flex: none;
  }
  .lang {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #C9D3DC;
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 600;
    padding: 9px 12px;
    min-height: 44px;
    border-radius: var(--r-sm);
    border: 1px solid rgba(255, 255, 255, 0.18);
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }
  .lang:hover {
    color: #fff;
    border-color: var(--gold);
    background: rgba(255, 255, 255, 0.06);
  }
  .lang svg {
    width: 16px;
    height: 16px;
    flex: none;
  }
  .hd__cta {
    min-height: 44px;
    padding: 10px 20px;
    font-size: 0.92rem;
  }

  /* burger */
  .burger {
    display: none;
    width: 46px;
    height: 46px;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: var(--r-sm);
    color: #fff;
    cursor: pointer;
  }
  .burger svg {
    width: 23px;
    height: 23px;
  }
  .burger path {
    transition: transform 0.2s, opacity 0.2s;
    transform-origin: center;
  }
  .burger[aria-expanded='true'] .burger__a {
    transform: translateY(6px) rotate(45deg);
  }
  .burger[aria-expanded='true'] .burger__b {
    opacity: 0;
  }
  .burger[aria-expanded='true'] .burger__c {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* mobile drawer */
  .mnav {
    display: none;
    background: var(--navy);
    border-block-start: 1px solid rgba(255, 255, 255, 0.09);
    padding: 8px clamp(18px, 4vw, 32px) 20px;
  }
  .mnav[hidden] {
    display: none;
  }
  .mnav.is-open {
    display: block;
  }
  .mnav nav {
    display: flex;
    flex-direction: column;
  }
  .mnav__l {
    color: #C9D3DC;
    text-decoration: none;
    font-size: 1.02rem;
    font-weight: 500;
    padding: 14px 6px;
    min-height: 48px;
    display: flex;
    align-items: center;
    border-block-end: 1px solid rgba(255, 255, 255, 0.07);
  }
  .mnav__l.is-active {
    color: var(--gold);
    font-weight: 600;
  }
  .mnav__foot {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-block-start: 16px;
  }
  .mnav__foot .btn {
    width: 100%;
  }
  .lang--m {
    justify-content: center;
  }

  @media (max-width: 1080px) {
    .nav-d {
      display: none;
    }
    .burger {
      display: inline-flex;
    }
    .hd__end {
      margin-inline-start: auto;
    }
  }
  @media (max-width: 620px) {
    .hd__cta,
    .hd__end > .lang {
      display: none;
    }
    .brand__name {
      font-size: 14.5px;
      white-space: normal;
    }
    .brand__sub {
      display: none;
    }
  }
</style>

<script>
  const burger = document.getElementById('burger');
  const panel = document.getElementById('mobile-nav');
  if (burger && panel) {
    const setOpen = (open: boolean) => {
      burger.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
      panel.classList.toggle('is-open', open);
      document.body.style.overflow = open ? 'hidden' : '';
    };
    burger.addEventListener('click', () => setOpen(burger.getAttribute('aria-expanded') !== 'true'));
    panel.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && burger.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        (burger as HTMLButtonElement).focus();
      }
    });
    // Reset when resizing up to the desktop breakpoint
    window.matchMedia('(min-width: 1081px)').addEventListener('change', (e) => e.matches && setOpen(false));
  }
</script>
