---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Newsletter from '../../components/Newsletter.astro';
import { useT, rel, LOCALES, SITE, type Locale } from '../../i18n/ui';
import { getArticles, getProjects } from '../../lib/content';
import { EXPERTISE, CREDENTIALS } from '../../data/profile';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const t = useT(locale);
const L = (b: { ar: string; en: string }) => b[locale];

const [articles, projects] = await Promise.all([getArticles(locale, { section: 'research' }), getProjects(locale)]);
const latest = articles.slice(0, 3);
const topProjects = projects.slice(0, 2);
---

<Base
  locale={locale}
  title={`${locale === 'ar' ? SITE.nameAr : SITE.nameEn} — ${t('home.title')}`}
  description={t('home.desc')}
  path=""
  ogType="profile"
>
  <!-- ===================== HERO ===================== -->
  <section class="hero">
    <div class="wrap hero__in">
      <div class="hero__txt">
        <p class="hero__eyebrow">{t('home.eyebrow')}</p>
        <h1>{t('home.h1')}</h1>
        <p class="hero__sub">{t('home.sub')}</p>
        <div class="hero__cta">
          <a class="btn btn--gold" href={rel(locale, 'contact')}>{t('home.cta1')}</a>
          <a class="btn btn--ghost" href={rel(locale, 'research')}>{t('home.cta2')}</a>
        </div>
      </div>
      <div class="hero__fig">
        <picture>
          <source srcset="/images/portrait-480.webp 480w, /images/portrait-720.webp 720w" sizes="(max-width: 900px) 240px, 340px" type="image/webp" />
          <img
            src="/images/portrait-480.jpg"
            srcset="/images/portrait-480.jpg 480w, /images/portrait-720.jpg 720w"
            sizes="(max-width: 900px) 240px, 340px"
            width="480"
            height="600"
            alt={locale === 'ar' ? `صورة شخصية لـ${SITE.nameAr}` : `Portrait of ${SITE.nameEn}`}
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </div>
    </div>
  </section>

  <!-- ===================== EXPERTISE ===================== -->
  <section class="section">
    <div class="wrap">
      <div class="shead">
        <span class="shead__eyebrow">{t('home.expertise.eyebrow')}</span>
        <h2>{t('home.expertise.h')}</h2>
      </div>
      <div class="grid grid-2">
        {
          EXPERTISE.map((e) => (
            <div class="card xcard">
              <span class="xcard__ic">
                <Icon name={e.icon} />
              </span>
              <div>
                <h3>{L(e.title)}</h3>
                <p>{L(e.text)}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== ARTICLES ===================== -->
  <section class="section section--tint">
    <div class="wrap">
      <div class="shead">
        <span class="shead__eyebrow">{t('home.articles.eyebrow')}</span>
        <h2>{t('home.articles.h')}</h2>
      </div>
      <div class="grid grid-3">
        {latest.map((a) => <ArticleCard locale={locale} entry={a} />)}
      </div>
      <p class="more-row"><a class="btn btn--outline" href={rel(locale, 'research')}>{t('home.articles.all')}</a></p>
    </div>
  </section>

  <!-- ===================== PROJECTS ===================== -->
  <section class="section">
    <div class="wrap">
      <div class="shead">
        <span class="shead__eyebrow">{t('home.projects.eyebrow')}</span>
        <h2>{t('home.projects.h')}</h2>
      </div>
      <div class="grid grid-2">
        {topProjects.map((p) => <ProjectCard locale={locale} entry={p} />)}
      </div>
      <p class="more-row"><a class="btn btn--outline" href={rel(locale, 'projects')}>{t('home.projects.all')}</a></p>
    </div>
  </section>

  <!-- ===================== CREDENTIALS ===================== -->
  <section class="creds">
    <div class="wrap">
      <div class="shead shead--light">
        <span class="shead__eyebrow">{t('home.credentials.eyebrow')}</span>
        <h2>{t('home.credentials.h')}</h2>
      </div>
      <div class="creds__grid">
        {
          CREDENTIALS.map((c) => (
            <div class="cred">
              <span class="cred__v ltr">{c.value}</span>
              <span class="cred__l">{L(c.label)}</span>
              <span class="cred__n">{L(c.note)}</span>
            </div>
          ))
        }
      </div>
      <p class="creds__note">{t('home.credentials.note')}</p>
    </div>
  </section>

  <!-- ===================== CV + NEWSLETTER ===================== -->
  <section class="section">
    <div class="wrap grid grid-2">
      <div class="card cv">
        <span class="cv__ic"><Icon name="download" /></span>
        <div>
          <h3>{t('home.cv.h')}</h3>
          <p>{t('home.cv.p')}</p>
          <div class="cv__btns">
            <a class="btn btn--primary" href="/files/Salaheldeen-Ijla-CV.pdf" download>{t('cv.download')}</a>
            <a class="btn btn--outline" href={rel(locale, 'about')}>{locale === 'ar' ? 'اعرف المزيد عني' : 'More about me'}</a>
          </div>
        </div>
      </div>
      <Newsletter locale={locale} />
    </div>
  </section>
</Base>

<style>
  /* ---- hero ---- */
  .hero {
    background: var(--navy);
    color: #E6ECF2;
    position: relative;
    overflow: hidden;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(60% 80% at 78% 8%, rgba(196, 154, 69, 0.11), transparent 62%);
    pointer-events: none;
  }
  .hero__in {
    display: grid;
    grid-template-columns: 1.35fr 0.65fr;
    gap: clamp(28px, 5vw, 60px);
    align-items: center;
    padding-block: clamp(48px, 7vw, 84px);
    position: relative;
    z-index: 2;
  }
  .hero__eyebrow {
    color: var(--gold);
    font-weight: 600;
    font-size: 0.9rem;
    letter-spacing: 0.02em;
    margin-block-end: 14px;
  }
  .hero h1 {
    color: #fff;
    font-size: clamp(26px, 2.1vw + 20px, 42px);
    line-height: 1.38;
    max-width: 20ch;
  }
  .hero__sub {
    color: #B7C4D1;
    font-size: clamp(1rem, 0.35vw + 0.95rem, 1.12rem);
    margin-block-start: 18px;
    max-width: 56ch;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-block-start: 28px;
  }
  .hero__fig {
    justify-self: center;
  }
  .hero__fig img {
    width: clamp(200px, 26vw, 320px);
    height: auto;
    border-radius: var(--r-lg);
    border: 1px solid rgba(196, 154, 69, 0.35);
    box-shadow: 0 18px 44px rgba(0, 0, 0, 0.3);
  }

  /* ---- expertise ---- */
  .xcard {
    flex-direction: row;
    gap: 16px;
    align-items: flex-start;
  }
  .xcard__ic {
    width: 46px;
    height: 46px;
    border-radius: 11px;
    background: var(--gold-tint);
    display: grid;
    place-items: center;
    flex: none;
  }
  .xcard__ic :global(svg) {
    width: 23px;
    height: 23px;
    stroke: var(--gold-dark);
  }

  .more-row {
    margin-block-start: clamp(22px, 3vw, 32px);
  }

  /* ---- credentials ---- */
  .creds {
    background: var(--navy);
    color: #D3DCE5;
    padding-block: clamp(48px, 6vw, 72px);
  }
  .creds :global(.shead h2) {
    color: #fff;
  }
  .creds :global(.shead__eyebrow) {
    color: var(--gold);
  }
  .creds__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: clamp(18px, 3vw, 32px);
  }
  .cred {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding-inline-start: 16px;
    border-inline-start: 2px solid rgba(196, 154, 69, 0.5);
  }
  .cred__v {
    color: var(--gold);
    font-size: clamp(30px, 2.5vw, 40px);
    font-weight: 700;
    line-height: 1;
  }
  .cred__l {
    color: #fff;
    font-weight: 600;
    font-size: 0.98rem;
  }
  .cred__n {
    color: #93A2B0;
    font-size: 0.85rem;
    line-height: 1.65;
  }
  .creds__note {
    color: #8998A6;
    font-size: 0.85rem;
    margin-block-start: 26px;
    max-width: 80ch;
  }

  /* ---- cv ---- */
  .cv {
    flex-direction: row;
    gap: 20px;
    align-items: flex-start;
  }
  .cv__ic {
    width: 52px;
    height: 52px;
    border-radius: 12px;
    background: var(--teal-tint);
    display: grid;
    place-items: center;
    flex: none;
  }
  .cv__ic :global(svg) {
    width: 25px;
    height: 25px;
    stroke: var(--teal);
  }
  .cv h3 {
    margin-block-end: 5px;
  }
  .cv p {
    color: var(--text-3);
    font-size: 0.94rem;
    margin-block-end: 14px;
  }
  .cv__btns {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  @media (max-width: 900px) {
    .hero__in {
      grid-template-columns: 1fr;
      text-align: start;
    }
    .hero__fig {
      order: -1;
      justify-self: start;
    }
    .hero h1 {
      max-width: none;
    }
  }
  @media (max-width: 560px) {
    .cv,
    .xcard {
      flex-direction: column;
    }
  }
</style>
