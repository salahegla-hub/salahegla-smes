---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Newsletter from '../../components/Newsletter.astro';
import { useT, rel, fmtDate, LOCALES, SITE, type Locale } from '../../i18n/ui';
import { getArticles, getProjects } from '../../lib/content';
import { EXPERTISE, CREDENTIALS } from '../../data/profile';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const t = useT(locale);
const L = (b: { ar: string; en: string }) => b[locale];

/* The homepage feed merges BOTH sections and sorts purely by date, so the
   newest thing published always surfaces first regardless of its type.
   This keeps the front page current with zero manual maintenance. */
const [researchPapers, generalArticles, projects] = await Promise.all([
  getArticles(locale, { section: 'research' }),
  getArticles(locale, { section: 'articles' }),
  getProjects(locale),
]);

const merged = [...researchPapers, ...generalArticles].sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

/* The single newest item gets a pinned card; the rest fill the grid below. */
const featured = merged[0];
const latest = merged.slice(1, 7);

const researchCount = researchPapers.length;
const articlesCount = generalArticles.length;
const topProjects = projects.slice(0, 2);

/** Short type label for the pinned card, kept local so this page needs no extra imports. */
function typeLabel(data: { contentType?: string; peerReviewed?: boolean }): string {
  if (data.peerReviewed) return locale === 'ar' ? 'محكَّم ومنشور' : 'Peer-reviewed';
  const map: Record<string, { ar: string; en: string }> = {
    article: { ar: 'مقال', en: 'Article' },
    'research-paper': { ar: 'ورقة بحثية', en: 'Research paper' },
    'working-paper': { ar: 'ورقة عمل', en: 'Working paper' },
    'policy-brief': { ar: 'موجز تحليلي', en: 'Analytical brief' },
    'economic-analysis': { ar: 'تحليل اقتصادي', en: 'Economic analysis' },
    guide: { ar: 'دليل عملي', en: 'Guide' },
    'case-study': { ar: 'دراسة حالة', en: 'Case study' },
  };
  const hit = data.contentType ? map[data.contentType] : undefined;
  return hit ? hit[locale] : locale === 'ar' ? 'منشور' : 'Publication';
}
---

<Base
  locale={locale}
  title={`${locale === 'ar' ? SITE.nameAr : SITE.nameEn} — ${t('home.title')}`}
  description={t('home.desc')}
  path=""
  ogType="profile"
>
  <!-- ===================== HERO ===================== -->
  <section class="hero">
    <div class="wrap hero__in">
      <div class="hero__txt">
        <p class="hero__eyebrow">{t('home.eyebrow')}</p>
        <h1>{t('home.h1')}</h1>
        <p class="hero__sub">{t('home.sub')}</p>
        <div class="hero__cta">
          <a class="btn btn--gold" href={rel(locale, 'contact')}>{t('home.cta1')}</a>
          <a class="btn btn--ghost" href={rel(locale, 'research')}>
            {locale === 'ar' ? 'الأوراق البحثية' : 'Research papers'}
          </a>
          <a class="btn btn--ghost" href={rel(locale, 'articles')}>
            {locale === 'ar' ? 'المقالات' : 'Articles'}
          </a>
        </div>
      </div>
      <div class="hero__fig">
        <picture>
          <source srcset="/images/portrait-480.webp 480w, /images/portrait-720.webp 720w" sizes="(max-width: 900px) 240px, 340px" type="image/webp" />
          <img
            src="/images/portrait-480.jpg"
            srcset="/images/portrait-480.jpg 480w, /images/portrait-720.jpg 720w"
            sizes="(max-width: 900px) 240px, 340px"
            width="480"
            height="600"
            alt={locale === 'ar' ? `صورة شخصية لـ${SITE.nameAr}` : `Portrait of ${SITE.nameEn}`}
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </div>
    </div>
  </section>

  <!-- ============ PINNED: newest publication, any type ============ -->
  {
    featured && (
      <section class="section featsec">
        <div class="wrap">
          <a class="feat" href={rel(locale, `articles/${featured.data.slug}`)}>
            <div class="feat__meta">
              <span class="feat__flag">{locale === 'ar' ? 'آخر ما نُشر' : 'Latest'}</span>
              <span class="feat__type">{typeLabel(featured.data)}</span>
              <span class="feat__date">{fmtDate(featured.data.publishDate, locale)}</span>
            </div>
            <h2 class="feat__t">{featured.data.title}</h2>
            {featured.data.subtitle && <p class="feat__sub">{featured.data.subtitle}</p>}
            <p class="feat__x">{featured.data.excerpt}</p>
            <span class="feat__cta">
              {locale === 'ar' ? 'اقرأ كامل المنشور' : 'Read the full piece'}
              <Icon name="arrow-right" />
            </span>
          </a>
        </div>
      </section>
    )
  }

  <!-- ===================== EXPERTISE ===================== -->
  <section class="section">
    <div class="wrap">
      <div class="shead">
        <span class="shead__eyebrow">{t('home.expertise.eyebrow')}</span>
        <h2>{t('home.expertise.h')}</h2>
      </div>
      <div class="grid grid-2">
        {
          EXPERTISE.map((e) => (
            <div class="card xcard">
              <span class="xcard__ic">
                <Icon name={e.icon} />
              </span>
              <div>
                <h3>{L(e.title)}</h3>
                <p>{L(e.text)}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ LATEST PUBLICATIONS (research + articles merged) ============ -->
  <section class="section section--tint">
    <div class="wrap">
      <div class="shead">
        <span class="shead__eyebrow">
          {locale === 'ar' ? 'أوراق بحثية ومقالات' : 'Research papers & articles'}
        </span>
        <h2>{locale === 'ar' ? 'أحدث المنشورات' : 'Latest publications'}</h2>
      </div>
      <div class="grid grid-3">
        {latest.map((a) => <ArticleCard locale={locale} entry={a} />)}
      </div>
      <p class="more-row more-row--split">
        <a class="btn btn--outline" href={rel(locale, 'research')}>
          {locale === 'ar' ? `كل الأوراق البحثية (${researchCount})` : `All research papers (${researchCount})`}
        </a>
        <a class="btn btn--outline" href={rel(locale, 'articles')}>
          {locale === 'ar' ? `كل المقالات (${articlesCount})` : `All articles (${articlesCount})`}
        </a>
      </p>
    </div>
  </section>

  <!-- ===================== PROJECTS ===================== -->
  <section class="section">
    <div class="wrap">
      <div class="shead">
        <span class="shead__eyebrow">{t('home.projects.eyebrow')}</span>
        <h2>{t('home.projects.h')}</h2>
      </div>
      <div class="grid grid-2">
        {topProjects.map((p) => <ProjectCard locale={locale} entry={p} />)}
      </div>
      <p class="more-row"><a class="btn btn--outline" href={rel(locale, 'projects')}>{t('home.projects.all')}</a></p>
    </div>
  </section>

  <!-- ===================== CREDENTIALS ===================== -->
  <section class="creds">
    <div class="wrap">
      <div class="shead shead--light">
        <span class="shead__eyebrow">{t('home.credentials.eyebrow')}</span>
        <h2>{t('home.credentials.h')}</h2>
      </div>
      <div class="creds__grid">
        {
          CREDENTIALS.map((c) => (
            <div class="cred">
              <span class="cred__v ltr">{c.value}</span>
              <span class="cred__l">{L(c.label)}</span>
              <span class="cred__n">{L(c.note)}</span>
            </div>
          ))
        }
      </div>
      <p class="creds__note">{t('home.credentials.note')}</p>
    </div>
  </section>

  <!-- ===================== CV + NEWSLETTER ===================== -->
  <section class="section">
    <div class="wrap grid grid-2">
      <div class="card cv">
        <span class="cv__ic"><Icon name="download" /></span>
        <div>
          <h3>{t('home.cv.h')}</h3>
          <p>{t('home.cv.p')}</p>
          <div class="cv__btns">
            <a class="btn btn--primary" href="/files/Salaheldeen-Ijla-CV.pdf" download>{t('cv.download')}</a>
            <a class="btn btn--outline" href={rel(locale, 'about')}>{locale === 'ar' ? 'اعرف المزيد عني' : 'More about me'}</a>
          </div>
        </div>
      </div>
      <Newsletter locale={locale} />
    </div>
  </section>
</Base>

<style>
  /* ---- hero ---- */
  .hero {
    background: var(--navy);
    color: #E6ECF2;
    position: relative;
    overflow: hidden;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(60% 80% at 78% 8%, rgba(196, 154, 69, 0.11), transparent 62%);
    pointer-events: none;
  }
  .hero__in {
    display: grid;
    grid-template-columns: 1.35fr 0.65fr;
    gap: clamp(28px, 5vw, 60px);
    align-items: center;
    padding-block: clamp(48px, 7vw, 84px);
    position: relative;
    z-index: 2;
  }
  .hero__eyebrow {
    color: var(--gold);
    font-weight: 600;
    font-size: 0.9rem;
    letter-spacing: 0.02em;
    margin-block-end: 14px;
  }
  .hero h1 {
    color: #fff;
    font-size: clamp(26px, 2.1vw + 20px, 42px);
    line-height: 1.38;
    max-width: 20ch;
  }
  .hero__sub {
    color: #B7C4D1;
    font-size: clamp(1rem, 0.35vw + 0.95rem, 1.12rem);
    margin-block-start: 18px;
    max-width: 56ch;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-block-start: 28px;
  }
  .hero__fig {
    justify-self: center;
  }
  .hero__fig img {
    width: clamp(200px, 26vw, 320px);
    height: auto;
    border-radius: var(--r-lg);
    border: 1px solid rgba(196, 154, 69, 0.35);
    box-shadow: 0 18px 44px rgba(0, 0, 0, 0.3);
  }

  /* ---- pinned newest publication ---- */
  .featsec {
    padding-block-end: 0;
  }
  .feat {
    display: block;
    background: var(--surface, #fff);
    border: 1px solid var(--line, rgba(20, 40, 60, 0.12));
    border-inline-start: 4px solid var(--gold);
    border-radius: var(--r-lg);
    padding: clamp(22px, 3.2vw, 36px);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.18s ease, transform 0.18s ease;
  }
  .feat:hover,
  .feat:focus-visible {
    border-color: var(--gold);
    transform: translateY(-2px);
  }
  .feat__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-block-end: 14px;
  }
  .feat__flag {
    background: var(--gold-tint);
    color: var(--gold-dark);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    padding: 4px 12px;
    border-radius: 999px;
  }
  .feat__type {
    background: var(--teal-tint);
    color: var(--teal);
    font-size: 0.78rem;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: 999px;
  }
  .feat__date {
    color: var(--text-3);
    font-size: 0.85rem;
  }
  .feat__t {
    font-size: clamp(21px, 1.5vw + 15px, 31px);
    line-height: 1.42;
    margin: 0;
    max-width: 44ch;
  }
  .feat__sub {
    color: var(--text-3);
    font-size: clamp(0.98rem, 0.25vw + 0.92rem, 1.08rem);
    line-height: 1.72;
    margin-block-start: 10px;
    max-width: 62ch;
  }
  .feat__x {
    font-size: 0.97rem;
    line-height: 1.85;
    margin-block-start: 14px;
    max-width: 74ch;
  }
  .feat__cta {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--teal);
    font-weight: 600;
    font-size: 0.95rem;
    margin-block-start: 18px;
  }
  .feat__cta :global(svg) {
    width: 17px;
    height: 17px;
    stroke: currentColor;
  }
  [dir='rtl'] .feat__cta :global(svg) {
    transform: scaleX(-1);
  }

  /* ---- expertise ---- */
  .xcard {
    flex-direction: row;
    gap: 16px;
    align-items: flex-start;
  }
  .xcard__ic {
    width: 46px;
    height: 46px;
    border-radius: 11px;
    background: var(--gold-tint);
    display: grid;
    place-items: center;
    flex: none;
  }
  .xcard__ic :global(svg) {
    width: 23px;
    height: 23px;
    stroke: var(--gold-dark);
  }

  .more-row {
    margin-block-start: clamp(22px, 3vw, 32px);
  }
  /* two browse buttons side by side, wrapping on narrow screens */
  .more-row--split {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* ---- credentials ---- */
  .creds {
    background: var(--navy);
    color: #D3DCE5;
    padding-block: clamp(48px, 6vw, 72px);
  }
  .creds :global(.shead h2) {
    color: #fff;
  }
  .creds :global(.shead__eyebrow) {
    color: var(--gold);
  }
  .creds__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: clamp(18px, 3vw, 32px);
  }
  .cred {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding-inline-start: 16px;
    border-inline-start: 2px solid rgba(196, 154, 69, 0.5);
  }
  .cred__v {
    color: var(--gold);
    font-size: clamp(30px, 2.5vw, 40px);
    font-weight: 700;
    line-height: 1;
  }
  .cred__l {
    color: #fff;
    font-weight: 600;
    font-size: 0.98rem;
  }
  .cred__n {
    color: #93A2B0;
    font-size: 0.85rem;
    line-height: 1.65;
  }
  .creds__note {
    color: #8998A6;
    font-size: 0.85rem;
    margin-block-start: 26px;
    max-width: 80ch;
  }

  /* ---- cv ---- */
  .cv {
    flex-direction: row;
    gap: 20px;
    align-items: flex-start;
  }
  .cv__ic {
    width: 52px;
    height: 52px;
    border-radius: 12px;
    background: var(--teal-tint);
    display: grid;
    place-items: center;
    flex: none;
  }
  .cv__ic :global(svg) {
    width: 25px;
    height: 25px;
    stroke: var(--teal);
  }
  .cv h3 {
    margin-block-end: 5px;
  }
  .cv p {
    color: var(--text-3);
    font-size: 0.94rem;
    margin-block-end: 14px;
  }
  .cv__btns {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  @media (max-width: 900px) {
    .hero__in {
      grid-template-columns: 1fr;
      text-align: start;
    }
    .hero__fig {
      order: -1;
      justify-self: start;
    }
    .hero h1 {
      max-width: none;
    }
  }
  @media (max-width: 560px) {
    .cv,
    .xcard {
      flex-direction: column;
    }
  }
</style>
